{
  "manifest_version": 3,
  "name": "Backipedia",
  "description": "View and compare historical versions of Wikipedia articles. Manuscripts don't burn.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.wikipedia.org/*",
    "https://*.m.wikipedia.org/*",
    "https://web.archive.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Backipedia – Historical View"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wikipedia.org/*",
        "https://*.m.wikipedia.org/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
